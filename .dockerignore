# The image pulls the MCC release straight from GitHub, so it needs no build context at
# all. Everything here is host-side state; data-*/ in particular holds account passwords,
# Discord tokens and live session caches, which must never reach an image layer.
data-*/
.env

.git/
.gitignore
Dockerfile
docker-compose.yml
README.md
MinecraftClient.example.ini
join.txt
